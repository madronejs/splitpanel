{
  "name": "@madronejs/splitpanel",
  "version": "0.3.0",
  "description": "CSS-Grid-driven split-panel runtime with a framework-free core and an optional Vue 3 wrapper.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madronejs/splitpanel.git"
  },
  "bugs": {
    "url": "https://github.com/madronejs/splitpanel/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.css",
    "types/**/*.d.ts"
  ],
  "keywords": [
    "splitpanel",
    "splitpane",
    "split-grid",
    "panel",
    "drag",
    "draggable",
    "resizable",
    "css-grid"
  ],
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/splitpanel.js",
      "require": "./dist/splitpanel.cjs"
    },
    "./vue": {
      "types": "./types/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./style": "./dist/splitpanel.css"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:node": "vitest --project node",
    "test:browser": "vitest --project browser",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "build-dev": "NODE_ENV=development pnpm build-all",
    "build-types": "rm -rf types/* && vue-tsc -p ./tsconfig.json && tsc-alias -p tsconfig.json",
    "build": "rm -rf dist/* && vite build",
    "build-all": "pnpm build-types && pnpm build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "all": "pnpm build-types && pnpm lint && CI=true pnpm test"
  },
  "devDependencies": {
    "@eslint/compat": "~2.1.1",
    "@eslint/eslintrc": "~3.3.7",
    "@eslint/js": "~10.0.1",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "~10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "fast-check": "^4.10.2",
    "globals": "~17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.12"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
